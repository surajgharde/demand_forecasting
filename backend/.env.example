# ============================================================
# Demand Forecasting API — Environment Configuration
# ============================================================
# Copy this file to .env  →  cp .env.example .env
# Fill in your own keys below. Both keys are OPTIONAL:
# - Without GROQ_API_KEY  → AI explanations use deterministic fallback text
# - Without Weather_API_KEY → Weather context uses "seasonal patterns" fallback
# ============================================================

# --- Groq AI API Key (for LLM-powered demand explanations via llama-3.3-70b) ---
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- OpenWeatherMap API Key (for weather context in AI analysis) ---
# Get a free key at: https://openweathermap.org/api
Weather_API_KEY=your_openweathermap_key_here

